								// need to adjust for local setup
// stage variables
xyStage = mmc.getXYStageDevice();
zStage = mmc.getFocusDevice();
double currentX, currentY, currentZ;
originX=-75385;
originY=331012;
double gapX=19500; // 24 w plate well spacing in microns
double gapY=19500;

// camera
camera = mmc.getCameraDevice();
double defaultExposure;
boolean cameraAutoExposure = true; // whether or not to use camera autoexposure
boolean removeFlag = true; // whether or not to remove extra frames from circular buffer
// set to true if using camera continuous autoexposure;
// set false if not available -- will then use software autoexposure (not debugged)
String autoExposeType="Once"; // options are Once, Continous, or Off (for Basler camera)
String cameraWidth="500";
